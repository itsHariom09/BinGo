<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title %></title>

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"/>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

<%- include('partials/header') %>

<!-- =========================
Hero Section
========================== -->

<section class="hero">

    <div class="container hero-grid">

        <div class="hero-left">

            <span class="hero-badge">

                ♻ Smart Waste Management

            </span>

            <h1>

                Keep Your Society

                <span>Clean</span>

                &

                <span>Smart</span>

            </h1>

            <p>

                Bingo connects Society Heads,

                Residents and Garbage Collectors

                into one intelligent waste management platform.

                Request garbage collection,

                assign collectors and monitor every activity

                in real time.

            </p>

            <div class="hero-buttons">

                <% if(!user){ %>

                <a href="/auth/login" class="btn btn-primary">

                    Login

                </a>

                <a href="/auth/register-society" class="btn btn-secondary">

                    Register Society

                </a>

                <% } else { %>

                    <% if(role==='society'){ %>

                        <a href="/head/dashboard" class="btn btn-primary">

                            Go to Dashboard

                        </a>

                    <% } %>

                    <% if(role==='member'){ %>

                        <a href="/member/dashboard" class="btn btn-primary">

                            Go to Dashboard

                        </a>

                    <% } %>

                    <% if(role==='collector'){ %>

                        <a href="/collector/dashboard" class="btn btn-primary">

                            Go to Dashboard

                        </a>

                    <% } %>

                <% } %>

            </div>

        </div>

        <div class="hero-right">

            <img src="/Images/bingo.png" alt="Bingo">

        </div>

    </div>

</section>

<!-- =========================
Statistics
========================== -->

<section class="stats-section">

    <div class="container stats-grid">

        <div class="stat-box">

            <i class="fa-solid fa-building"></i>

            <h2>100+</h2>

            <p>Societies</p>

        </div>

        <div class="stat-box">

            <i class="fa-solid fa-users"></i>

            <h2>10K+</h2>

            <p>Members</p>

        </div>

        <div class="stat-box">

            <i class="fa-solid fa-truck"></i>

            <h2>250+</h2>

            <p>Collectors</p>

        </div>

        <div class="stat-box">

            <i class="fa-solid fa-recycle"></i>

            <h2>25K+</h2>

            <p>Collections</p>

        </div>

    </div>

</section>

<!-- =========================
How It Works
========================== -->

<section class="how-it-works">

<div class="container">

<h2 class="section-title">

How Bingo Works

</h2>

<div class="work-grid">

<div class="work-card">

<div class="number">

1

</div>

<i class="fa-solid fa-user-plus"></i>

<h3>Register</h3>

<p>

Register your Society,

Member or Collector account.

</p>

</div>

<div class="work-card">

<div class="number">

2

</div>

<i class="fa-solid fa-trash-can-arrow-up"></i>

<h3>Create Request</h3>

<p>

Residents create garbage

collection requests instantly.

</p>

</div>

<div class="work-card">

<div class="number">

3

</div>

<i class="fa-solid fa-user-check"></i>

<h3>Assign Collector</h3>

<p>

Society Head assigns

available collector.

</p>

</div>

<div class="work-card">

<div class="number">

4

</div>

<i class="fa-solid fa-circle-check"></i>

<h3>Collection Complete</h3>

<p>

Collector completes the request

and updates status.

</p>

</div>

</div>

</div>

</section>

<!-- =========================
Features
========================== -->

<section class="features">

<div class="container">

<h2 class="section-title">

Why Choose Bingo?

</h2>

<div class="feature-grid">

<div class="feature-card">

<i class="fa-solid fa-users"></i>

<h3>Society Management</h3>

<p>

Manage all members

from one dashboard.

</p>

</div>

<div class="feature-card">

<i class="fa-solid fa-trash"></i>

<h3>Collection Requests</h3>

<p>

One-click garbage collection

request system.

</p>

</div>

<div class="feature-card">

<i class="fa-solid fa-route"></i>

<h3>Collector Tracking</h3>

<p>

Assign collectors

efficiently.

</p>

</div>

<div class="feature-card">

<i class="fa-solid fa-chart-line"></i>

<h3>Analytics</h3>

<p>

Daily collection

statistics and reports.

</p>

</div>

<div class="feature-card">

<i class="fa-solid fa-lock"></i>

<h3>Secure Login</h3>

<p>

Encrypted authentication

using sessions.

</p>

</div>

<div class="feature-card">

<i class="fa-solid fa-mobile-screen"></i>

<h3>Responsive Design</h3>

<p>

Works perfectly on

Mobile, Tablet & Desktop.

</p>

</div>

</div>

</div>

</section>

<!-- =========================
CTA
========================== -->

<section class="cta">

<div class="container">

<h2>

Ready to make your society cleaner?

</h2>

<p>

Join Bingo today and experience

smart waste management.

</p>

<a href="/auth/register-society"

class="btn btn-primary">

Get Started

</a>

</div>

</section>

<%- include('partials/footer') %>

</body>

</html>