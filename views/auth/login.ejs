<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | Bingo</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
    >

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/login.css">
</head>

<body>

<%- include('../partials/header') %>

<section class="login-section">

<div class="login-container">

<div class="login-left">

<div class="logo-box">
<i class="fa-solid fa-recycle"></i>
<h1>Bingo</h1>
</div>

<h2>Smart Waste Management System</h2>

<p>
Manage your society's waste collection efficiently with
real-time tracking and digital request management.
</p>

<div class="feature-list">

<div class="feature">
<i class="fa-solid fa-circle-check"></i>
<span>Easy Waste Requests</span>
</div>

<div class="feature">
<i class="fa-solid fa-circle-check"></i>
<span>Collector Tracking</span>
</div>

<div class="feature">
<i class="fa-solid fa-circle-check"></i>
<span>Smart Society Dashboard</span>
</div>

<div class="feature">
<i class="fa-solid fa-circle-check"></i>
<span>100% Digital Management</span>
</div>

</div>

</div>

<div class="login-right">

<div class="card">

<h2>Welcome Back 👋</h2>

<p class="subtitle">
Login to continue using Bingo.
</p>

<% if(typeof error !== 'undefined'){ %>

<div class="error-box">
<i class="fa-solid fa-circle-exclamation"></i>
<%= error %>
</div>

<% } %>

<form action="/auth/login" method="POST" id="loginForm">

<div class="input-group">

<label>Login As</label>

<div class="input-box">

<i class="fa-solid fa-user"></i>

<select
name="role"
id="role"
required>

<option value="society">
Society Head
</option>

<option value="member">
Society Member
</option>

<option value="collector">
Garbage Collector
</option>

</select>

</div>

</div>

<div class="input-group">

<label>Email Address</label>

<div class="input-box">

<i class="fa-solid fa-envelope"></i>

<input
type="email"
name="email"
placeholder="Enter Email"
required>

</div>

</div>

<div class="input-group">

<label>Password</label>

<div class="input-box password-box">

<i class="fa-solid fa-lock"></i>

<input
type="password"
name="password"
id="password"
placeholder="Enter Password"
required>

<span id="togglePassword">

<i class="fa-solid fa-eye"></i>

</span>

</div>

</div>

<div class="login-options">

<label>

<input type="checkbox">

Remember Me

</label>

<a href="#">
Forgot Password?
</a>

</div>

<button
type="submit"
class="login-btn"
id="loginBtn">

<i class="fa-solid fa-right-to-bracket"></i>

Login

</button>

</form>

<div class="register-area">

<p>
Don't have an account?
</p>

<div class="register-buttons">

<a href="/auth/register-society">

Register Society

</a>

<a href="/auth/register-collector">

Register Collector

</a>

</div>

</div>

</div>

</div>

</div>

</section>

<%- include('../partials/footer') %>

<script>

const password=document.getElementById("password");

const toggle=document.getElementById("togglePassword");

toggle.onclick=()=>{

if(password.type==="password"){

password.type="text";

toggle.innerHTML='<i class="fa-solid fa-eye-slash"></i>';

}

else{

password.type="password";

toggle.innerHTML='<i class="fa-solid fa-eye"></i>';

}

}

document
.getElementById("loginForm")
.addEventListener("submit",()=>{

document.getElementById("loginBtn").innerHTML=

'<i class="fa fa-spinner fa-spin"></i> Logging In...';

});

</script>

</body>
</html>